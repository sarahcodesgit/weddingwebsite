# Browser-safe Supabase values only. These are bundled by Vite and must be publishable keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Keep demo mode until Supabase migrations, Edge Functions, and phone/SMS verification are configured and tested.
VITE_RSVP_MODE=live

# Never put SUPABASE_SECRET_KEY, service_role, database passwords, SMS provider credentials, or RSVP rate-limit secrets in this file.
# Supabase Edge Function secrets belong in Supabase only; see README.md.
